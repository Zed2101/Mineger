{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mineger",
  "version": "1.0.1",
  "identifier": "com.zed.mineger",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run css:watch",
    "beforeBuildCommand": "npm run css:build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mineger",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
